[Unit]
Description=Cruze P2P video chat signaling
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/cruze
ExecStart=/srv/cruze/.venv/bin/python /srv/cruze/server.py
Environment=CRUZE_TRUST_PROXY=1
StateDirectory=cruze
StateDirectoryMode=0700
Environment=CRUZE_DB=/var/lib/cruze/audit.sqlite3
EnvironmentFile=-/etc/cruze/admin.env
Environment=HOST=127.0.0.1
Environment=PORT=8774
Environment=CRUZE_ORIGIN=https://cruze.cc
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
